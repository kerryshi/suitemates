# Copy to .env (never commit .env). Every key is optional for keyless dev: `npm run chat` works with none.
# Share real values in the team chat, not in git.

# --- run mode ---
TRANSPORT=terminal          # terminal | imessage
MOCK=1                      # 1 = personas read mock/ (default); 0 = real Canvas/Nessie
FAKE_LLM=0                  # 1 = force the keyless fake LLM even with a key
FAKE_ROUTE=                 # e.g. social,financial,academic forces the group router (demo safety net)

# --- Gemini (aistudio.google.com) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash   # npm run check-gemini lists the flash models your key can see

# --- names (team picks; folders stay role-named) ---
PRODUCT_NAME=Suitemates
ACADEMIC_NAME=Dean
FINANCIAL_NAME=Penny
SOCIAL_NAME=Sunny

# --- Photon (app.photon.codes) — shape 1: one project, one dedicated line per persona ---
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
ACADEMIC_LINE=              # +1..., the number Academic texts from (also used to ignore our own texts in the group)
FINANCIAL_LINE=
SOCIAL_LINE=
DEFAULT_PERSONA=academic    # who answers on a line we can't match (e.g. a shared-pool number)
# --- web sign-up / QR (core/photon-users.ts) ---
PHOTON_AUTO_ADD=0           # 1 = sign-ups are added to Photon Users via the CLI (npm i -g @photon-ai/cli, then photon login)
PHOTON_API_TOKEN=           # optional: CLI token instead of photon login
POOL_NUMBER=                # fallback number the sign-up page opens iMessage to, if the CLI can't tell us theirs
PUBLIC_URL=                 # public https address of this server (tunnel); used in calendar links, e.g. https://xyz.trycloudflare.com
CAL_SECRET=                 # signs the private calendar links (defaults to SPECTRUM_PROJECT_SECRET)
# --- shape 2: one project per persona (overrides shape 1 for that persona; still set *_LINE) ---
ACADEMIC_PROJECT_ID=
ACADEMIC_PROJECT_SECRET=
FINANCIAL_PROJECT_ID=
FINANCIAL_PROJECT_SECRET=
SOCIAL_PROJECT_ID=
SOCIAL_PROJECT_SECRET=

# --- data sources ---
NESSIE_API_KEY=             # nessieisreal.com (GitHub sign-in)
NESSIE_ACCOUNT_ID=
CANVAS_TOKEN=               # Canvas → Account → Settings → New Access Token
CANVAS_BASE_URL=https://uncch.instructure.com
CANVAS_OWNER_PHONE=        # the token owner's phone: only this user ever gets live Canvas (everyone else: mock)
CANVAS_LIVE=0               # 1 = live Canvas for the owner even with MOCK=1 (real data goes through Gemini: paid key only)

# --- server / proactive ---
PORT=3000
DEMO_TOKEN=                 # if set, /demo/trigger needs ?token=
WATCH=financial             # personas whose watch() is polled
WATCH_MS=10000
GROUP_SETTLE_MS=1500
MORNING_AT=08:00            # academic.morning_due
WEEKLY_PLAN_AT=sun 19:00    # academic.weekly_plan
WEEKLY_AT=sun 18:00         # financial.weekly_money
DATA_FILE=data/state.json
SERVER_URL=                 # for `npm run trigger` against a running server, e.g. http://localhost:3000
